{
  "entities": {
    "SavedPlay": {
      "title": "SavedPlay",
      "description": "A registered SuperEnalotto play (system or manual) with columns, cost, status, and verification results.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the saved play" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "targetContestId": { "type": "string", "description": "Target contest identifier (e.g. 2026-175)" },
        "mode": { "type": "string", "enum": ["pure_coverage", "superstar", "manual"] },
        "cost": { "type": "number", "description": "Total cost in Euro" },
        "savedAmount": { "type": "number", "description": "Piggybank saved amount in Euro" },
        "poolNumbers": { "type": "array", "items": { "type": "number" } },
        "columns": { "type": "array", "description": "Played 6-number columns" },
        "status": { "type": "string", "enum": ["IN_ATTESA", "VERIFICATA"] },
        "result": { "type": "object", "description": "Verification result and winning details" },
        "manualNote": { "type": "string", "description": "Optional user note" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "userEmail": { "type": "string", "description": "Normalized email of the user who owns this play" }
      },
      "required": ["id", "createdAt", "targetContestId", "mode", "cost", "poolNumbers", "columns", "status"]
    },
    "UserAccessRecord": {
      "title": "UserAccessRecord",
      "description": "Access Control List (ACL) record for an authorized, pending, or rejected Gmail user.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Normalized lowercase Gmail address" },
        "name": { "type": "string", "description": "Display name of the user" },
        "picture": { "type": "string", "description": "Optional avatar URL" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] },
        "status": { "type": "string", "enum": ["AUTHORIZED", "PENDING", "REJECTED"] },
        "requestedAt": { "type": "string", "description": "ISO timestamp when access was requested" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last status change" },
        "authorizedBy": { "type": "string", "description": "Administrator identifier" },
        "note": { "type": "string", "description": "Optional request or authorization note" }
      },
      "required": ["email", "name", "role", "status", "requestedAt", "updatedAt"]
    },
    "CustomDraw": {
      "title": "CustomDraw",
      "description": "Custom or newly imported SuperEnalotto draw beyond the static historical seed.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Draw contest ID (e.g. 2026-175)" },
        "contestNumber": { "type": "number" },
        "year": { "type": "number" },
        "date": { "type": "string" },
        "numbers": { "type": "array", "items": { "type": "number" } },
        "jolly": { "type": "number" },
        "superstar": { "type": "number" }
      },
      "required": ["id", "contestNumber", "year", "date", "numbers", "jolly"]
    },
    "UserGeneratedSystemRecord": {
      "title": "UserGeneratedSystemRecord",
      "description": "Per-user persisted optimized system (sestine) and generator configuration.",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string", "description": "Normalized email of the user" },
        "updatedAt": { "type": "string", "description": "ISO timestamp when system was explicitly calculated" },
        "poolSizeV": { "type": "number" },
        "playMode": { "type": "string", "enum": ["pure_coverage", "superstar", "manual"] },
        "coverageTarget": { "type": "string", "enum": ["ambi", "terni"] },
        "selectedBudget": { "type": "number" },
        "budgetMode": { "type": "string", "enum": ["preset", "custom"] },
        "selectedPool": { "type": "array", "items": { "type": "number" } },
        "manualPoolEdit": { "type": "boolean" },
        "weights": { "type": "object" },
        "filters": { "type": "object" },
        "systemResult": { "type": "object", "description": "Generated columns and coverage metrics" }
      },
      "required": ["userEmail", "updatedAt", "systemResult"]
    },
    "UserSimulationStateRecord": {
      "title": "UserSimulationStateRecord",
      "description": "Per-user persisted Monte Carlo simulation seed and parameters.",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string", "description": "Normalized email of the user" },
        "updatedAt": { "type": "string", "description": "ISO timestamp when simulation was explicitly executed" },
        "simSeed": { "type": "number", "description": "Deterministic PRNG seed for the user's locked simulation" },
        "methodology": { "type": "string", "enum": ["hypergeometric_pure_urn", "bayesian_hybrid_urn"] },
        "numDrawsToSimulate": { "type": "number" },
        "coverageTarget": { "type": "string", "enum": ["ambi", "terni"] },
        "smartPoolSize": { "type": "number" }
      },
      "required": ["userEmail", "updatedAt", "simSeed", "methodology", "numDrawsToSimulate"]
    },
    "DeletedPlayTombstone": {
      "title": "DeletedPlayTombstone",
      "description": "Tombstone record for a deleted SavedPlay to prevent resurrection across browsers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Deleted play ID" },
        "deletedAt": { "type": "string", "description": "ISO timestamp of deletion" }
      },
      "required": ["id", "deletedAt"]
    }
  },
  "firestore": {
    "/plays/{playId}": {
      "schema": { "$ref": "#/entities/SavedPlay" },
      "description": "Cloud-persisted registered plays isolated per user across browsers and sessions."
    },
    "/deleted_plays/{playId}": {
      "schema": { "$ref": "#/entities/DeletedPlayTombstone" },
      "description": "Cloud-persisted tombstones of deleted plays so no browser re-uploads a deleted play."
    },
    "/acl/{emailKey}": {
      "schema": { "$ref": "#/entities/UserAccessRecord" },
      "description": "Cloud-persisted user access control records (authorized, pending, rejected)."
    },
    "/custom_draws/{drawId}": {
      "schema": { "$ref": "#/entities/CustomDraw" },
      "description": "Cloud-persisted custom or newly added SuperEnalotto draws."
    },
    "/user_systems/{emailKey}": {
      "schema": { "$ref": "#/entities/UserGeneratedSystemRecord" },
      "description": "Per-user persisted optimized sestine in the System Generator."
    },
    "/user_simulations/{emailKey}": {
      "schema": { "$ref": "#/entities/UserSimulationStateRecord" },
      "description": "Per-user persisted Monte Carlo simulation state and deterministic seed."
    }
  }
}
