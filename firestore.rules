rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@gmail[.]com$');
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function admin() {
      return verifiedGoogle() && myEmail() == 'giuseppe.vitiello@gmail.com';
    }

    function approved() {
      return admin() || (verifiedGoogle()
        && exists(/databases/$(database)/documents/acl_verified/$(myEmail()))
        && get(/databases/$(database)/documents/acl_verified/$(myEmail())).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/acl_verified/$(myEmail())).data.role == 'USER'
        && get(/databases/$(database)/documents/acl_verified/$(myEmail())).data.status == 'AUTHORIZED');
    }

    function ownEmail(email) {
      return approved() && email == myEmail();
    }

    function ownsPlay(data) {
      return ownEmail(data.get('userEmail', 'giuseppe.vitiello@gmail.com'));
    }

    function ownSystemKey(key) {
      return approved() && (key == myEmail() || key == 'camel::' + myEmail()
        || key == 'wfi::' + myEmail() || key == 'cover60::' + myEmail()
        || key == 'cover90::' + myEmail());
    }

    function isValidPlay(data, playId) {
      return data.keys().hasAll(['id', 'createdAt', 'targetContestId', 'mode', 'cost', 'poolNumbers', 'columns', 'status'])
        && data.id is string
        && data.id == playId
        && data.id.size() > 0 && data.id.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.targetContestId is string && data.targetContestId.size() > 0 && data.targetContestId.size() <= 64
        && data.mode in ['pure_coverage', 'superstar', 'manual']
        && data.cost is number && data.cost >= 0 && data.cost <= 1000000
        && data.poolNumbers is list && data.poolNumbers.size() <= 90
        && data.columns is list && data.columns.size() >= 1 && data.columns.size() <= 200
        && data.status in ['IN_ATTESA', 'VERIFICATA'];
    }

    function isValidAclRequest(data, emailKey) {
      return data.keys().hasOnly(['uid', 'email', 'name', 'role', 'status', 'requestedAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.email is string
        && data.email == emailKey
        && data.email.size() >= 3 && data.email.size() <= 254
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.requestedAt is string && data.requestedAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.status == 'PENDING' && data.role == 'USER';
    }

    function isValidCustomDraw(data, drawId) {
      return data.keys().hasAll(['id', 'contestNumber', 'year', 'date', 'numbers', 'jolly'])
        && data.id is string
        && data.id == drawId
        && data.id.size() > 0 && data.id.size() <= 64
        && data.contestNumber is number && data.contestNumber >= 1
        && data.year is number && data.year >= 1997 && data.year <= 2100
        && data.date is string && data.date.size() <= 32
        && data.numbers is list && data.numbers.size() == 6
        && data.jolly is number && data.jolly >= 1 && data.jolly <= 90;
    }

    function isValidUserSystem(data, emailKey) {
      return data.keys().hasAll(['userEmail', 'updatedAt', 'systemResult'])
        && data.userEmail is string
        && data.userEmail == emailKey
        && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.systemResult is map
        && data.systemResult.columns is list
        && data.systemResult.columns.size() >= 1 && data.systemResult.columns.size() <= 200;
    }

    function isValidUserSimulation(data, emailKey) {
      return data.keys().hasAll(['userEmail', 'updatedAt', 'simSeed', 'methodology', 'numDrawsToSimulate'])
        && data.userEmail is string
        && data.userEmail == emailKey
        && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.simSeed is number
        && data.methodology in ['hypergeometric_pure_urn', 'bayesian_hybrid_urn']
        && data.numDrawsToSimulate is number && data.numDrawsToSimulate >= 100 && data.numDrawsToSimulate <= 250000;
    }

    function isValidDeletedPlayTombstone(data, playId) {
      return data.keys().hasAll(['id', 'deletedAt'])
        && data.id is string
        && data.id == playId
        && data.id.size() > 0 && data.id.size() <= 128
        && data.deletedAt is string && data.deletedAt.size() <= 64;
    }

    match /plays/{playId} {
      allow read: if admin() || (approved() && resource.data.userEmail == myEmail());
      allow create: if isValidPlay(request.resource.data, playId)
        && ownEmail(request.resource.data.userEmail)
        && !exists(/databases/$(database)/documents/deleted_plays/$(playId));
      allow update: if isValidPlay(request.resource.data, playId)
        && ownsPlay(resource.data) && ownsPlay(request.resource.data);
      allow delete: if ownsPlay(resource.data);
    }

    match /deleted_plays/{playId} {
      allow read: if admin() || (approved() && resource.data.userEmail == myEmail());
      allow create: if isValidDeletedPlayTombstone(request.resource.data, playId)
        && ownEmail(request.resource.data.userEmail)
        && ownsPlay(get(/databases/$(database)/documents/plays/$(playId)).data)
        && !existsAfter(/databases/$(database)/documents/plays/$(playId));
    }

    match /acl_verified/{emailKey} {
      allow list: if admin();
      allow get: if admin() || (verifiedGoogle() && emailKey == myEmail());
      allow create: if verifiedGoogle() && !admin() && emailKey == myEmail()
        && isValidAclRequest(request.resource.data, emailKey);
      allow update: if admin()
        && resource.data.role == 'USER'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 64
        && request.resource.data.status in ['AUTHORIZED', 'REJECTED'];
    }

    match /custom_draws/{drawId} {
      allow read: if approved();
      allow create, update: if admin() && isValidCustomDraw(request.resource.data, drawId);
      allow delete: if admin();
    }

    match /user_systems/{emailKey} {
      allow get, delete: if ownSystemKey(emailKey);
      allow create, update: if ownSystemKey(emailKey)
        && isValidUserSystem(request.resource.data, emailKey)
        && (!emailKey.matches('^cover(60|90)::.*') || (
          request.resource.data.keys().hasOnly(['userEmail', 'updatedAt', 'id', 'selectionNote', 'historyMessage', 'systemResult'])
          && request.resource.data.id is string && request.resource.data.id.matches('^[a-zA-Z0-9-]{1,64}$')
          && request.resource.data.selectionNote is string && request.resource.data.selectionNote.size() <= 240
          && request.resource.data.historyMessage is string && request.resource.data.historyMessage.size() <= 240
          && request.resource.data.systemResult.keys().hasOnly(['columns'])
          && request.resource.data.systemResult.columns.size() == (emailKey.matches('^cover60::.*') ? 10 : 15)
        ));
    }

    match /user_simulations/{emailKey} {
      allow get, delete: if ownEmail(emailKey);
      allow create, update: if ownEmail(emailKey) && isValidUserSimulation(request.resource.data, emailKey);
    }

    match /_connection_test/{docId} {
      allow read: if approved();
    }
  }
}
